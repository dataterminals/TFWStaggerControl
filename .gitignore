# build scratch / decode staging
pak/staging/**
!pak/staging/.gitkeep
work/
*.tmp

# C# build output
tools/skillpatch/bin/
tools/skillpatch/obj/

# decoded game assets must NOT be committed (copyrighted) — only our authored/patched assets
*.uasset.orig
*.uexp
*.ubulk

# external tools (fetched per-machine)
tools/retoc/
*.usmap

# dist releases are TRACKED — the shipped zips (and our own authored paks) travel with the
# repo so a second dev machine gets them on `git pull`. Heavy build scratch never goes here:
# it lives in pak/staging/ and work/ (ignored above). Only commit our own content to dist/.
